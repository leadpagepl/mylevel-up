# --- Powiadomienia e-mail o zgłoszeniach z formularza ---------------------
# W produkcji (next build + next start, Vercel) te zmienne są WYMAGANE:
# sukces pokazujemy dopiero, gdy Resend potwierdzi wysyłkę. Bez nich formularz
# zwraca błąd i pokazuje telefon oraz e-mail szkoły.
# Lokalnie (npm run dev) zgłoszenia zapisują się też do .data/zgloszenia.jsonl
# i to wystarcza do testów.
#
# Klucz API z https://resend.com (darmowy plan wystarcza na ten wolumen).
RESEND_API_KEY=
# Adres, na który mają trafiać zgłoszenia:
BOOKING_TO_EMAIL=mylevelup01@gmail.com
# Adres nadawcy z domeny zweryfikowanej w Resend, np. strona@mylevelup.pl
BOOKING_FROM_EMAIL=
